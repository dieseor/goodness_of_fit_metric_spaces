\name{dpgof-package}
\alias{dpgof-package}
\alias{dpgof}
\title{Distance-profile goodness-of-fit tests}
\description{Goodness-of-fit tests for distributions on metric spaces, based on distance profiles and calibrated with a multiplier bootstrap. See the README for installation and an example.}
\details{
The models used in the paper are the restricted spiked normal, the normal with
scalar covariance, the multivariate normal, the logistic Gaussian, the von
Mises--Fisher, the hyperbolic von Mises--Fisher, the cardioid, the small-circle
and the uniform--beta mixture. The other \code{multiplier_bootstrap_*} wrappers
are not used in the paper and have been tested less.
}
